rules_version = '2';

// Firebase Storage security rules for Workin Fit.
//
// Exercise images are admin-write / signed-in-read. Admin status is read from
// the user's Firestore `users/{uid}.role` field via firestore.get(), mirroring
// firestore.rules. Profile avatars stay owner-write.
//
// NOTE: Must be deployed to take effect. See doc/ADMIN_SETUP.md.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Exercise images uploaded from the admin editor: exercise_images/{id}/{kind}.jpg
    match /exercise_images/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Profile avatars: profile_images/{uid}.jpg — owner write only.
    match /profile_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && fileName.matches(request.auth.uid + '[.].*');
    }
  }
}
