  "terms_of_service_section_5_content": "All content, features, and functionality of Workin Fit are owned by us and are protected by copyright, trademark, and other intellectual property laws.",
  "terms_of_service_section_6_title": "6. Limitation of Liability",
  "terms_of_service_section_6_content": "Workin Fit shall not be liable for any indirect, incidental, special, or consequential damages arising out of or in connection with your use of the app.",
  "terms_of_service_section_7_title": "7. Changes to Terms",
  "terms_of_service_section_7_content": "We reserve the right to modify these Terms of Service at any time. Your continued use of the app after any changes constitutes acceptance of the new terms.",
